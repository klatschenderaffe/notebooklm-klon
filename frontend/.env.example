# Kopieren nach .env.local und mit echten Werten füllen. Wird NIE committet (siehe .gitignore).

# URL des Backend-Services (lokal: http://localhost:8000, produktiv: Render-URL)
VITE_API_URL=http://localhost:8000

# Supabase Projekt-Einstellungen -> Project Settings -> Data API
# Der Anon-Key ist bewusst öffentlich/im Frontend sichtbar (anders als der Service-Key
# im Backend) -- das ist sein vorgesehener Einsatzzweck für Supabase Auth im Browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
