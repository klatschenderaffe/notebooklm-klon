# Kopieren nach .env und mit echten Werten füllen. .env wird NIE committet (siehe .gitignore).

# Google AI Studio -> API-Key erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Modell-Versionen überschreiben, falls Google neue Versionen veröffentlicht
# (Standardwerte in app/config.py, Stand 21.09.2026: gemini-3.7-flash / gemini-embedding-2 —
# gemini-3.6-flash (vorheriger Standard) lieferte an diesem Tag wiederholt 503 "high
# demand", gemini-2.5-flash liefert für diesen Account 404 (nicht verfügbar), auf
# gemini-3.7-flash gewechselt, da live getestet aktuell stabil. Rund eine Stunde
# später geriet aber auch gemini-3.7-flash in denselben "high demand"-Zustand —
# GEMINI_CHAT_MODEL_FALLBACK (Standard: gemini-3.5-flash) wird automatisch genutzt,
# wenn das primäre Modell trotz Retry weiter überlastet ist, siehe gemini_client.py)
# GEMINI_CHAT_MODEL=gemini-3.7-flash
# GEMINI_CHAT_MODEL_FALLBACK=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Supabase Projekt-Einstellungen -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Nur nötig, falls das Projekt (noch) legacy HS256-JWTs signiert statt asymmetrischer
# Signing Keys (JWKS) -> Project Settings -> Data API -> JWT Settings -> "JWT Secret".
# Bei asymmetrischen Keys wird stattdessen automatisch der öffentliche JWKS-Endpunkt genutzt.
SUPABASE_JWT_SECRET=

# Kommagetrennte Liste erlaubter Frontend-Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# Optional: Mindest-Kosinus-Ähnlichkeit (0-1), ab der ein Chunk als relevant genug gilt,
# um als Chat-Kontext/Zitat verwendet zu werden (Standard in app/config.py: 0.7).
# CHAT_SIMILARITY_THRESHOLD=0.7

# Optional: Sentry Error-Tracking (Phase 5, DevOps-Hardening). Bei leerem SENTRY_DSN
# (Standard) wird Sentry gar nicht initialisiert -> ohne Sentry-Account einfach leer lassen.
# DSN erstellen: https://sentry.io -> Projekt anlegen -> Client Keys (DSN).
SENTRY_DSN=

# Umgebungsbezeichnung, die u.a. an Sentry als "environment" mitgegeben wird
# (z.B. development, staging, production). Standard in app/config.py: development.
ENVIRONMENT=

# Optional: Anteil der Requests (0.0-1.0), für die Sentry Performance-Traces erfasst
# (Standard in app/config.py: 1.0 = 100%, sinnvoll für die Staging-/Demo-Phase ohne
# echten Produktivtraffic). Bei echtem Produktivbetrieb mit nennenswertem Traffic auf
# z.B. 0.1-0.2 reduzieren, um im kostenlosen Sentry-Kontingent (5.000.000 Spans/Monat)
# zu bleiben.
# SENTRY_TRACES_SAMPLE_RATE=1.0
