# Kopieren nach .env und mit echten Werten füllen. .env wird NIE committet (siehe .gitignore).

# Google AI Studio -> API-Key erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Modell-Versionen überschreiben, falls Google neue Versionen veröffentlicht
# (Standardwerte in app/config.py, Stand September 2026: gemini-3.6-flash / gemini-embedding-2 —
# gemini-3.8-flash lieferte beim ersten Live-Test wiederholt 503 "high demand",
# gemini-2.5-flash ist laut Google-API bereits deprecated, gemini-3.6-flash lief stabil)
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Supabase Projekt-Einstellungen -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Nur nötig, falls das Projekt (noch) legacy HS256-JWTs signiert statt asymmetrischer
# Signing Keys (JWKS) -> Project Settings -> Data API -> JWT Settings -> "JWT Secret".
# Bei asymmetrischen Keys wird stattdessen automatisch der öffentliche JWKS-Endpunkt genutzt.
SUPABASE_JWT_SECRET=

# Kommagetrennte Liste erlaubter Frontend-Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173
